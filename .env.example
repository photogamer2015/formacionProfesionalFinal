# Copia este archivo como ".env" en la raíz del proyecto y rellena los
# valores. El archivo .env real está ignorado por Git (ver .gitignore),
# así que NUNCA termina en el repositorio.

# ─── Seguridad ──────────────────────────────────────────────────────
# En producción genera una clave aleatoria:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# En AWS/produccion usa tus dominios HTTPS, separados por coma.
# Si lo dejas vacio y DEBUG=False, Django intenta construirlo desde ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=

# HTTPS detras de Nginx o un Application Load Balancer.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ─── Base de datos ──────────────────────────────────────────────────
# Si DEJAS VACÍO DB_NAME, Django usa SQLite (db.sqlite3 en la raíz).
# Esto es lo recomendado para empezar / desarrollo local.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── MercyBot / OpenAI ──────────────────────────────────────────────
# Clave de la API de OpenAI para el asistente MercyBot.
# Consíguela en https://platform.openai.com/api-keys
# Si la dejas vacía, MercyBot funciona en modo básico (sin IA).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Correo para códigos de acceso ─────────────────────────────────
# Para Gmail usa una "contraseña de aplicación", no la contraseña normal.
# Ejemplo:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=formacionprofesional.edu.ec@gmail.com
#   EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=formacionprofesional.edu.ec@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=formacionprofesional.edu.ec@gmail.com
EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=formacionprofesional.edu.ec@gmail.com

# ─── Recordatorios automáticos de pagos ────────────────────────────
# Usan la misma configuración SMTP anterior. En producción (DEBUG=False)
# están activos por defecto; esta variable permite dejarlo explícito.
PAYMENT_REMINDER_EMAIL_ENABLED=True
PAYMENT_REMINDER_EMAIL_TIMEOUT=15
ENROLLMENT_CONFIRMATION_EMAIL_ENABLED=True
